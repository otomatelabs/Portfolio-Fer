---
import head from '../legacy/project.head.html?raw';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string | null;
}
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <Fragment set:html={head} />
    <link rel="stylesheet" href="/case-v2.css">
    <link rel="stylesheet" href="/chrome.css">
</head>
<body>
<a class="skip-link" href="#main-content" data-i18n="a11y.skip">Skip to content</a>
<Nav />
<main id="main-content" tabindex="-1">
<slot />
</main>
<Footer />
    <script is:inline src="/i18n.js"></script>
    <script is:inline src="/animations.js"></script>
    <script is:inline src="/script.js"></script>
</body>
</html>
