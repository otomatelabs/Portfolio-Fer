---
// Template for pipeline-generated case studies. Reuses the site's project-* classes; new pieces live in /case-v2.css.
import T from './T.astro';

type L = { es: string; en: string };
interface Props {
  data: any;
}
const { data } = Astro.props;
const ui: Record<string, L> = {
  back: { es: 'Volver a proyectos', en: 'Back to projects' },
  demo: { es: 'Probar la demo', en: 'Try the live demo' },
  repo: { es: 'Ver código', en: 'View code' },
  problem: { es: 'El problema', en: 'The problem' },
  evidence: { es: 'Evidencia', en: 'Evidence' },
  process: { es: 'Proceso actual vs automatizado', en: 'Current vs automated process' },
  before: { es: 'Hoy (manual)', en: 'Today (manual)' },
  after: { es: 'Con la automatización', en: 'Automated' },
  assumption: { es: 'SUPUESTO', en: 'ASSUMPTION' },
  built: { es: 'Qué construimos', en: 'What we built' },
  notAutomated: { es: 'Qué NO automatizamos', en: 'What we do NOT automate' },
  notAutomatedSub: {
    es: 'La IA prepara, una persona decide. Estos puntos quedan siempre en manos humanas.',
    en: 'AI prepares, a person decides. These steps always stay with a human.',
  },
  risks: { es: 'Riesgos y límites', en: 'Risks and limits' },
  next: { es: 'Siguientes funciones', en: 'What comes next' },
  details: { es: 'Detalles del proyecto', en: 'Project details' },
  client: { es: 'Para quién', en: 'Built for' },
  duration: { es: 'Duración', en: 'Duration' },
  role: { es: 'Rol', en: 'Role' },
  metric: { es: 'Métrica clave', en: 'Key metric' },
  stack: { es: 'Stack', en: 'Stack' },
  disclaimer: {
    es: 'Demo con datos sintéticos. No es asesoría aduanal ni legal.',
    en: 'Demo with synthetic data. Not customs or legal advice.',
  },
};
const minutes = (steps: { minutes: number | null }[]) => steps.reduce((sum, s) => sum + (s.minutes ?? 0), 0);
const dateFmt = (d: string) => d;
---
    <header class="project-hero">
        <div class="project-hero-bg"></div>
        <div class="project-hero-content" data-animate="fade-up" data-duration="900">
            <a href="/#work" class="project-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                <T t={ui.back} />
            </a>
            <div class="project-tags">{data.tags.map((tag: string) => <span class="project-tag">{tag}</span>)}</div>
            <h1 class="project-title"><T t={data.title} /></h1>
            <p class="project-subtitle"><T t={data.subtitle} /></p>
            <div class="case-actions">
                <a class="btn btn-primary" href={data.demoUrl} target="_blank" rel="noopener"><T t={ui.demo} /> ↗</a>
                {data.repoUrl && <a class="btn btn-ghost" href={data.repoUrl} target="_blank" rel="noopener"><T t={ui.repo} /></a>}
            </div>
        </div>
    </header>

    <main class="project-body">
        <div class="project-body-inner" data-animate="fade-up" data-duration="900">
            <div class="project-main">
                {data.video && (
                    <figure class="project-image case-video">
                        <video src={data.video.src} poster={data.video.poster} controls muted playsinline preload="none"></video>
                    </figure>
                )}

                <h2><T t={ui.problem} /></h2>
                {data.problem.statement.map((p: L) => <p><T t={p} /></p>)}

                <h3 class="case-subhead"><T t={ui.evidence} /></h3>
                <ol class="case-evidence">
                    {data.problem.evidence.map((e: any) => (
                        <li>
                            <p><T t={e.claim} /></p>
                            <a href={e.url} target="_blank" rel="noopener">{e.source}</a>
                            <span class="case-evidence-meta">{e.type} · {dateFmt(e.date)}</span>
                        </li>
                    ))}
                </ol>

                <h2><T t={ui.process} /></h2>
                <div class="case-process">
                    {[['before', data.process.before], ['after', data.process.after]].map(([kind, steps]: any) => (
                        <div class={`case-process-col case-process-${kind}`}>
                            <div class="case-process-head">
                                <T t={ui[kind]} />
                                <span class="case-process-total">{minutes(steps)} min</span>
                            </div>
                            <ol>
                                {steps.map((s: any) => (
                                    <li>
                                        <T t={s.text} />
                                        {s.minutes !== null && <span class="case-step-min">{s.minutes} min</span>}
                                        {s.assumption && <span class="case-flag"><T t={ui.assumption} /></span>}
                                    </li>
                                ))}
                            </ol>
                        </div>
                    ))}
                </div>

                <h2><T t={ui.built} /></h2>
                <p><T t={data.built.summary} /></p>
                <ul>{data.built.bullets.map((b: L) => <li><T t={b} /></li>)}</ul>

                {data.gallery.length > 0 && (
                    <div class="project-gallery">
                        {data.gallery.map((m: any) => (
                            <figure class="project-image">
                                <img src={m.src} alt={m.alt.en} loading="lazy" />
                                {m.caption && <figcaption><T t={m.caption} /></figcaption>}
                            </figure>
                        ))}
                    </div>
                )}

                <section class="case-human">
                    <h2><T t={ui.notAutomated} /></h2>
                    <p class="case-human-sub"><T t={ui.notAutomatedSub} /></p>
                    <ul>{data.notAutomated.map((n: L) => <li><T t={n} /></li>)}</ul>
                </section>

                {data.risks.length > 0 && (
                    <>
                        <h2><T t={ui.risks} /></h2>
                        <ul>{data.risks.map((r: L) => <li><T t={r} /></li>)}</ul>
                    </>
                )}

                {data.nextFeatures.length > 0 && (
                    <>
                        <h2><T t={ui.next} /></h2>
                        <ul class="case-next">{data.nextFeatures.map((f: L) => <li><T t={f} /></li>)}</ul>
                    </>
                )}

                <p class="case-disclaimer"><T t={ui.disclaimer} /></p>
            </div>

            <aside class="project-sidebar">
                <div class="project-sidebar-card">
                    <h3 class="project-sidebar-title"><T t={ui.details} /></h3>
                    <div class="project-sidebar-item">
                        <div class="project-sidebar-label"><T t={ui.client} /></div>
                        <div class="project-sidebar-value"><T t={data.sidebar.client} /></div>
                    </div>
                    <div class="project-sidebar-item">
                        <div class="project-sidebar-label"><T t={ui.duration} /></div>
                        <div class="project-sidebar-value"><T t={data.sidebar.duration} /></div>
                    </div>
                    <div class="project-sidebar-item">
                        <div class="project-sidebar-label"><T t={ui.role} /></div>
                        <div class="project-sidebar-value"><T t={data.sidebar.role} /></div>
                    </div>
                    <div class="project-sidebar-item">
                        <div class="project-sidebar-label"><T t={ui.metric} /></div>
                        <div class="project-metric-highlight">{data.sidebar.metric.value}</div>
                        <div class="project-sidebar-value"><T t={data.sidebar.metric.label} /></div>
                    </div>
                    <div class="project-sidebar-item">
                        <div class="project-sidebar-label"><T t={ui.stack} /></div>
                        <div class="case-stack">{data.sidebar.stack.map((s: string) => <span class="project-tag">{s}</span>)}</div>
                    </div>
                    <a class="btn btn-primary case-sidebar-cta" href={data.demoUrl} target="_blank" rel="noopener"><T t={ui.demo} /> ↗</a>
                </div>
            </aside>
        </div>
    </main>
