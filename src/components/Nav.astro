---
// Shared top bar. On the home it is locked dark and highlights the section being read; on case pages it follows the
// page theme (with the theme switch) and marks "Work" as current.
import T from './T.astro';
import { NAV, LINKS } from '../lib/home';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const base = home ? '' : '/';
const cta = { es: 'Agendar llamada', en: 'Book a call' };
---
<nav class="ol-nav" id="olnav" data-theme={home ? 'dark' : undefined} aria-label="Principal">
  <div class="ol-wrap ol-nav-in">
    <a class="ol-logo" href={home ? '#top' : '/'} aria-label="Otomate Labs"><img src="/Logo.png" alt="" width="30" height="30"><span>Otomate Labs</span></a>
    <ul class="ol-menu" id="menu">
      {NAV.map((n) => (
        <li><a href={`${base}${n.href}`} data-k={n.k} aria-current={!home && n.k === 'casos' ? 'true' : undefined}><T t={n.t} /></a></li>
      ))}
    </ul>
    <div class="ol-tools">
      <button class="ol-chip-btn lang-toggle" type="button" aria-label="Language / Idioma" data-i18n="nav.lang">ES</button>
      {!home && (
        <button class="ol-chip-btn" type="button" id="theme-toggle" aria-label="Theme">
          <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
        </button>
      )}
      <a class="ol-btn ol-pri ol-cta-nav" href={LINKS.call} target="_blank" rel="noopener"><T t={cta} /></a>
      <button class="ol-burger" id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="menu"><span></span><span></span></button>
    </div>
  </div>
</nav>
