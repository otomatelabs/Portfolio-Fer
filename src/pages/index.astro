---
import head from '../legacy/home.head.html?raw';
import top from '../legacy/home.top.html?raw';
import bottom from '../legacy/home.bottom.html?raw';
import WorkCard from '../components/WorkCard.astro';
import { getProjects, sortForGrid } from '../lib/projects';

const projects = sortForGrid(await getProjects());
---
<!DOCTYPE html>
<html lang="en">
<head>
<Fragment set:html={head} />
    <link rel="canonical" href="https://otomatelabs.com/">
    <link rel="stylesheet" href="/case-v2.css">
</head>
<body>
<Fragment set:html={top} />
{projects.map((project) => <WorkCard project={project} />)}
<Fragment set:html={bottom} />
    <script is:inline src="/i18n.js"></script>
    <script is:inline src="/animations.js"></script>
    <script is:inline src="/script.js"></script>
</body>
</html>
